tive="1" as="geometry"></mxGeometry></mxCell><mxCell id="c142" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.3706;" edge="1" parent="1" source="c95" target="c124"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c143" value="&lt;b&gt;Polimorfismo&lt;/b&gt;&lt;br&gt;• UsuarioController depende de la interfaz UsuarioService; en tiempo de ejecución Spring inyecta UsuarioServiceImpl.&lt;br&gt;• Usuario sobrescribe el método abstracto Persona.getNombreCompleto().&lt;br&gt;• GlobalExceptionHandler.manejarNegocio(NegocioException) atiende a UsuarioNoEncontradoException (404) y CorreoDuplicadoException (409): cada subclase sobrescribe getCodigo() y getHttpStatus()." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2080" y="1332" width="400" height="140" as="geometry"/></mxCell><mxCell id="c144" value="&lt;b&gt;Llave compuesta de búsqueda&lt;/b&gt;&lt;br&gt;nombre + correo localizan al usuario en consulta, actualización y eliminación. No sustituye a la PK (id).&lt;br&gt;&lt;br&gt;&lt;b&gt;Sin @PathVariable ni @RequestParam&lt;/b&gt;: los datos llegan en Request DTOs con @RequestBody y @Valid." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2520" y="1332" width="360" height="140" as="geometry"/></mxCell><mxCell id="c145" value="&lt;b&gt;Endpoints&lt;/b&gt; (/api/v1/usuarios)&lt;br&gt;POST&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ → crear (201)&lt;br&gt;GET&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ → listar paginado (200)&lt;br&gt;POST&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/busqueda → buscar (200)&lt;br&gt;POST&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/consulta → consultar (200 / 404)&lt;br&gt;PATCH&amp;nbsp;&amp;nbsp;&amp;nbsp;/actualizacion → actualizar (200 / 404 / 409)&lt;br&gt;DELETE /eliminacion → eliminar (200 / 404)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2080" y="1502" width="340" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>